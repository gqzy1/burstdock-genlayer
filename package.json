{
  "name": "burstdock-genlayer",
  "version": "1.0.0",
  "description": "Source-grounded API burst planning with exact token-bucket schedules on GenLayer.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "test": "python -m unittest discover -s tests -v && npm run test:sdk",
    "test:sdk": "node --import tsx --test tests/sdk.test.ts",
    "typecheck": "tsc --noEmit",
    "check:schema": "node --import tsx scripts/schema.ts",
    "deploy": "node --import tsx scripts/deploy.ts",
    "accept:live": "node --import tsx scripts/live.ts",
    "verify:live": "node --import tsx scripts/verify.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "genlayer-js": "1.1.8"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "private": true
}
